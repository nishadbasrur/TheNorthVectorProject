# North Vector environment variables

AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Plaid — get these from https://dashboard.plaid.com/team/keys
# PLAID_ENV must be "sandbox" or "production" (code defaults to sandbox if unset).
PLAID_ENV="sandbox"
PLAID_CLIENT_ID=""
PLAID_SECRET=""

# Firebase Admin SDK service account (local dev only). Paste the entire
# downloaded JSON key as a single line, single-quoted.
FIREBASE_SERVICE_ACCOUNT_KEY=''

# Google Cloud Text-to-Speech service account (local dev only). Paste the
# entire downloaded JSON key as a single line, single-quoted.
GOOGLE_TTS_SERVICE_ACCOUNT_KEY=''

# Symmetric key (AES-256-GCM) for encrypting Plaid access tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLAID_ENCRYPTION_KEY=""

# Voyage AI embeddings (lib/memory-embeddings.ts) — General/ tier memory
# semantic retrieval. Free tier (200M tokens on signup, no billing account
# required) — get a key at https://dashboard.voyageai.com/
VOYAGE_API_KEY=""

# Google Calendar (lib/google-calendar-client.ts) — OAuth2 client + a
# refresh token obtained once via scripts/oauth-switch-calendar-account.js
# (or the equivalent widen-scopes script), not through this app itself.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REFRESH_TOKEN=""

# iCloud Mail (lib/icloud-mail-client.ts) — IMAP with an app-specific
# password, generated at appleid.apple.com -> Sign-In and Security ->
# App-Specific Passwords (not the real Apple ID password).
ICLOUD_EMAIL_ADDRESS=""
ICLOUD_APP_PASSWORD=""

# iCloud Calendar (lib/icloud-calendar-client.ts) — CalDAV, same Apple ID
# as above but a DEDICATED app-specific password (so it can be revoked
# independently of Mail access later), generated the same way.
ICLOUD_CALENDAR_APP_PASSWORD=""
