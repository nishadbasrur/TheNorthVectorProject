+            audio: {
+                ...(deviceId ? { deviceId: { exact: deviceId } } : {}),
+                echoCancellation: false,
+                noiseSuppression: false,
+                autoGainControl: false,
+            }
         });
 
+        // Direct track-level mute/end monitoring — a much more definitive
+        // signal than inferring "audio went dead" from RMS alone. Bluetooth
+        // headsets in particular are known to interrupt/renegotiate their
+        // input route (e.g. switching between an output-optimized profile
+        // during TTS playback and a mic-capable one for capture) — if that
+        // renegotiation doesn't complete cleanly, the MediaStreamTrack can
+        // stay technically "live" while delivering silence, or the browser
+        // can flip its `muted` flag during the transition. Logging these
+        // directly removes the guesswork of inferring that from a flat RMS
+        // reading after the fact.
+        for (const track of this._mediaStream.getAudioTracks()) {
+            this._debug('Mic track acquired', { label: track.label, muted: track.muted, readyState: track.readyState });
