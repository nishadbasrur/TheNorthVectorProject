+            track.onunmute = () => this._debug('Mic track unmuted', { label: track.label });
+            track.onended = () => this._debug('Mic track ended', { label: track.label });
+        }
+
         this._audioContext = new AudioContext({ sampleRate: this.config.sampleRate });
