node_modules
.next
.env.local
tsconfig.tsbuildinfo
.DS_Store

# Tauri macOS wrapper — Rust build artifacts and generated capability
# schemas, not the src-tauri source itself.
src-tauri/target/
src-tauri/gen/

.agents/
skills-lock.json

.claude/
.agents/
skills-lock.json

# Local personal imports — the whole directory, not per-subfolder, so a
# newly-added import source (e.g. true-export/) is never silently untracked.
data/imports/

# Local memory database
data/memories/

# Impeccable design-hook per-developer state — consent flag and session
# dedup cache (has machine-local absolute paths). The shared
# .impeccable/config.json (detector ignores) is real project config and
# stays committed.
.impeccable/config.local.json
.impeccable/hook.cache.json

# Cloud Functions build output (bundled by esbuild, not source)
functions/lib/

# stt-stream-service / agent-runner-service build output (bundled by
# esbuild, not source — see each directory's package.json build script)
stt-stream-service/server.js
agent-runner-service/server.mjs

# Cloud Functions plain (non-secret) env vars, same treatment as .env.local
functions/.env

# Wake-word ONNX models + onnxruntime-web WASM binaries — copied from
# node_modules by scripts/copy-wake-word-assets.js (predev/prebuild), not
# source. node_modules is already gitignored; duplicating ~80MB of binaries
# into git history would be pure bloat for files npm already manages.
public/models/
public/ort/

# One-time throwaway OAuth re-consent scripts (see each one's own header
# comment) — local tools to run once when widening OAuth scopes, not app code.
scripts/oauth-widen-scopes.js
scripts/oauth-widen-scopes-drive.js
scripts/oauth-switch-calendar-account.js
scripts/oauth-switch-gmail-account.js

# Mac Mini Messages agent's real secret + runtime state — machine-specific,
# never committed. agent.js and the LaunchAgent plist template are the real
# source; .env holds the actual MAC_AGENT_INGEST_SECRET value.
scripts/mac-messages-agent/.env
scripts/mac-messages-agent/state.json
scripts/mac-messages-agent/agent.lock

# Local build artifact from scripts/build-curriculum-library.mts — resumable checkpoint, not source
scripts/.curriculum-library-checkpoint.json
