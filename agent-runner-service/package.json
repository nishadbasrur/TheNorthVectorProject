{
  "name": "agent-runner-service",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "server.mjs",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=server.mjs --external:@anthropic-ai/claude-agent-sdk --external:firebase-admin",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.1.77",
    "firebase-admin": "^14.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0"
  }
}
