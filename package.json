{
  "name": "north-vector",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "predev": "node scripts/copy-wake-word-assets.js",
    "dev": "next dev",
    "prebuild": "node scripts/copy-wake-word-assets.js",
    "build": "next build",
    "start": "next start",
    "lint": "echo lint skipped for scaffold",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "typecheck:all": "npm run typecheck && npm --prefix functions run typecheck",
    "build:all": "npm run build && npm --prefix functions run build",
    "tauri": "tauri",
    "tauri:dev": "concurrently -k -n next,tauri \"npm:dev\" \"tauri dev\"",
    "tauri:build": "tauri build"
  },
