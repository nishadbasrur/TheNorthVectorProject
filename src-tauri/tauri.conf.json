{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "North Vector",
  "version": "0.1.0",
  "identifier": "com.northvector.desktop",
  "build": {
    "devUrl": "http://localhost:3000/sandbox?wakeword-debug=1",
    "frontendDist": "https://north-vector--the-north-vector-project.us-east4.hosted.app"
  },
  "app": {
    "windows": [
      {
        "title": "North Vector",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
